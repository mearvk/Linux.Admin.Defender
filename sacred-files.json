{
  "schema": "linux.admin.defender.sacred-files.v1",
  "title": "Protected Directories by Linux Distribution",
  "purpose": "Defensive inventory describing operating-system directories and interfaces that should receive elevated administrative control, integrity monitoring, careful change management, backup, and appropriate access restrictions.",
  "source_inventory": "linux-systems.json",
  "qualification": "These are defensive baseline classifications, not assertions that every path is immutable. Exact paths, ownership, permissions, mount points, service managers, and security mechanisms vary by distribution, release, installation, and filesystem layout.",
  "control_principles": [
    "Require appropriate administrative authorization for changes to operating-system resources.",
    "Prefer distribution package managers and signed packages for system software changes.",
    "Use filesystem permissions, Linux Security Modules, auditing, backups, and integrity monitoring where appropriate.",
    "Treat kernel interfaces and device namespaces as live system interfaces rather than ordinary files.",
    "Do not disable security controls merely to modify protected system resources."
  ],
  "common_protected_directories": [
    { "path": "/", "role": "Filesystem root and operating-system namespace." },
    { "path": "/boot", "role": "Bootloader, kernel, initramfs, and boot assets where used." },
    { "path": "/etc", "role": "System-wide configuration and service configuration." },
    { "path": "/usr", "role": "Installed operating-system programs, libraries, documentation, and shared resources." },
    { "path": "/usr/bin", "role": "Common executable programs." },
    { "path": "/usr/sbin", "role": "System-administration executables." },
    { "path": "/usr/lib", "role": "Shared libraries and supporting operating-system data." },
    { "path": "/var", "role": "Variable system data, package state, service state, caches, queues, and logs." },
    { "path": "/var/log", "role": "System and application logs used for operations and auditing." },
    { "path": "/var/lib", "role": "Persistent service, package, database, and application state." },
    { "path": "/var/spool", "role": "Queued work such as mail, print, and scheduled jobs where used." },
    { "path": "/home", "role": "User home directories and user application state." },
    { "path": "/root", "role": "Root administrator home directory." },
    { "path": "/run", "role": "Volatile runtime state and service coordination." },
    { "path": "/sys", "role": "Kernel sysfs interface to devices, drivers, and kernel subsystems." },
    { "path": "/proc", "role": "Kernel process and system information interface." },
    { "path": "/dev", "role": "Dynamic device-node and kernel device interface hierarchy." },
    { "path": "/tmp", "role": "System temporary-file namespace." },
    { "path": "/var/tmp", "role": "Persistent temporary-file namespace." }
  ],
